  {
    "function": {
      "description": "Offer a user-clickable app action. This does NOT start a camera, spend credits, or generate images. For try-on pass exact wardrobe item IDs in layer order; for guide pass skill_id; for image-studio pass prompt.",
      "name": "open_screen",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "item_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Item Ids",
            "type": "array"
          },
          "prompt": {
            "default": "",
            "maxLength": 500,
            "title": "Prompt",
            "type": "string"
          },
