# Copy to .env and fill in. Without LLM_API_KEY the app runs in offline demo (mock) mode.
LLM_BASE_URL=https://openrouter.ai/api/v1   # API bên thứ 3, OpenAI-compatible
LLM_API_KEY=
VISION_MODEL=google/gemini-2.5-flash         # model nhanh, có vision — chấm từng frame
COMPILER_MODEL=google/gemini-2.5-flash       # model sinh skill (có thể mạnh hơn)
SHADOW_MODE=auto        # auto = mock nếu không có key; mock; ai
VISION_MIN_INTERVAL_MS=1200

# Ví dụ gateway Qwen (vLLM) — đã test 2026-11-09:
# LLM_BASE_URL=https://llm.hypertek.vn/v1
# VISION_MODEL=qwen3-vl-8b-instruct      # ~0.6–1.1s/frame
# COMPILER_MODEL=qwen3.6-35b-a3b         # thực chất là Qwen3.8-27B; ~14s để sinh skill
# Tắt chế độ "suy nghĩ" của Qwen để nhanh (bật thì 5–14s/frame). Nhớ để trong dấu nháy đơn:
# LLM_EXTRA_BODY='{"chat_template_kwargs": {"enable_thinking": false}}'

# Số frame LIÊN TIẾP phải báo "xong" thì mới chuyển bước (chống AI chấm nhầm 1 lần)
COMPLETE_CONFIRM_FRAMES=2

# ---- Hướng dẫn (AI nhìn camera chấm từng bước): nhanh + chính xác ----
# Xác nhận nhanh: khi 1 frame vừa báo "xong", server gửi vision.result có "confirming": true và
# chấm frame KẾ TIẾP ngay (bỏ qua VISION_MIN_INTERVAL_MS một lần). App nên gửi frame mới ngay khi
# thấy confirming=true. off = như cũ (chờ frame định kỳ). Đo: rút ~0.9 s mỗi bước.
VISION_FAST_CONFIRM=on
# Cạnh dài tối đa (px) của ảnh người học gửi cho AI. Server tự thu nhỏ ảnh lớn hơn (128–512).
VISION_IMAGE_MAX_SIDE=448
# Khi nào gửi kèm ảnh mẫu của người dạy:
#   always = mọi frame · never = không bao giờ · first = chỉ frame đầu của mỗi bước
#   auto = frame đầu của bước + frame ngay sau một lần "chưa đúng" có gợi ý (đang làm sai)
# Đo trên 20 ảnh thật: kèm ảnh mẫu không tăng độ chính xác ở 448px (95% cả hai) nhưng chậm gấp ~2
# (thêm 1 ảnh cho AI đọc) → mặc định auto: chỉ gửi ảnh mẫu ở những frame cần so sánh.
VISION_REFERENCE_MODE=auto
# Cách AI ra quyết định:
#   json    = AI trả JSON {"flag": …, "hint": "…"} (mặc định, có gợi ý sửa sai mỗi frame)
#   logprob = AI chỉ trả 1 chữ yes/no (hoặc A/B/C… với bộ nhận diện dạng lựa chọn) kèm xác suất;
#             chỉ tính "xong" khi xác suất ≥ VISION_DONE_THRESHOLD. Gợi ý được tạo riêng (1 lần gọi
#             JSON ngắn) chỉ khi người học bị kẹt (≥3 frame "chưa xong" liên tiếp sau mẹo). Gateway
#             không hỗ trợ logprobs thì tự quay về json.
VISION_DECISION=json
VISION_DONE_THRESHOLD=0.9

# ---- Trợ lý tủ đồ (wardrobe stylist + mặc thử) ----
# STYLIST_MODEL=                     # tuỳ chọn; mặc định dùng COMPILER_MODEL để chọn bộ phối
# SHADOW_WARDROBE_DIR=               # tuỳ chọn; mặc định backend/wardrobe
# SHADOW_DEMO_SEED=default           # bộ "Nạp tủ đồ mẫu" mặc định: default (bộ mẫu cơ bản) | shop (đồ nam mùa hè YaMe; cần ảnh: cd backend/wardrobe_seed_shop && ../../.venv/bin/python build_seed_shop.py)
# Mặc thử trực tiếp (Decart lucy-vton-latest, WebRTC). Backend chỉ phát client token ngắn hạn.
DECART_API_KEY=
# DECART_TOKEN_TTL_S=60              # thời hạn client token (1–3600 giây, mặc định 60)
# DECART_MAX_SESSION_S=180           # giới hạn cứng độ dài 1 phiên realtime do Decart áp (mặc định 180, tối đa 1800)
# Ảnh mặc thử: fashn (pilot thương mại) | auto (worker → hf_space → mock) | worker | hf_space | mock
TRYON_PHOTO_PROVIDER=auto
FASHN_API_KEY=                       # bắt buộc khi TRYON_PHOTO_PROVIDER=fashn
# FASHN_BASE_URL=https://api.fashn.ai
TRYON_WORKER_URL=                    # vd http://mac-mini.local:8188 (tryon-worker CatVTON)
HF_TOKEN=                            # tuỳ chọn, quota tốt hơn cho HF Space
HF_TRYON_SPACE=yisol/IDM-VTON        # giấy phép CC BY-NC-SA 4.0 — phi thương mại

# Mật khẩu chung với tryon-worker trên Mac mini (nếu đặt TRYON_TOKEN ở đó)
# TRYON_TOKEN=

# ---- Bảo vệ khi mở ra internet (ngrok) ----
# Mã truy cập chung cho buổi demo. Để trống = tắt (chạy local như cũ). Khi đặt, /api/*, /session/*,
# /skills-media/*, /wardrobe-media/* cần mã: app hỏi mã 1 lần (lưu cookie HttpOnly 12h), hoặc chia sẻ
# link https://<ngrok>/?code=<mã> (mở là có cookie, không phải gõ). Trang web tĩnh và /api/health vẫn mở.
# SHADOW_ACCESS_CODE=
# SHADOW_RATE_LIMIT=on               # off = tắt giới hạn tần suất theo IP
# SHADOW_MAX_BODY_MB=16              # giới hạn kích thước request
# SHADOW_TRYON_MAX_CONCURRENT=2      # số ảnh mặc thử chạy cùng lúc (toàn server)
# SHADOW_LIVE_TOKENS_PER_HOUR=60     # số token Decart cấp mỗi giờ (toàn server)
# SHADOW_WS_MAX_PER_IP=3             # WebSocket hướng dẫn đồng thời / IP
# SHADOW_WS_MAX_TOTAL=30
