# Cấu hình worker mặc thử (copy thành .env; run.sh và setup_macmini.sh tự đọc file này).
# Bỏ dấu # ở đầu dòng để bật một tuỳ chọn.

# Cổng HTTP (laptop gọi http://<ip-mac-mini>:PORT)
PORT=8188

# Mật khẩu chung (tuỳ chọn). Nếu đặt, SHADOW phải gửi header X-Tryon-Token giống hệt.
# TRYON_TOKEN=doi-thanh-chuoi-bi-mat

# Số bước khử nhiễu mặc định (nhiều hơn = đẹp hơn nhưng chậm hơn). 20-30 là hợp lý.
# TRYON_STEPS=30

# Độ phân giải WxH (bội số 64). 768x1024 = chất lượng gốc; 576x768 nhanh ~2x; 384x512 nhanh ~5x.
# TRYON_RESOLUTION=576x768   (mặc định; 768x1024 đẹp hơn nhưng chậm ~2x)

# Nạp mô hình + chạy thử 2 bước ngay khi khởi động (yêu cầu đầu tiên sẽ nhanh hơn).
# TRYON_WARMUP=1

# Chế độ giả lập (không cần mô hình) để thử kết nối SHADOW <-> worker.
# TRYON_MOCK=1

# Thiết bị: auto (mps -> cuda -> cpu) | mps | cpu
# TRYON_DEVICE=auto
# Kiểu số: auto (MPS: fp16 cho UNet, tự chuyển fp32 nếu ra NaN) | fp32 | fp16
# TRYON_DTYPE=auto

# Bộ lọc an toàn của Stable Diffusion (mặc định bật, như ứng dụng gốc của CatVTON).
# TRYON_SAFETY_CHECK=1

# Cách tạo mask vùng quần áo: schp (phân tích người, mặc định) | box (hình chữ nhật, chỉ để thử)
# TRYON_MASKER=schp

# Hugging Face token (tuỳ chọn, chỉ khi bị giới hạn tốc độ tải)
# HF_TOKEN=hf_xxx

# Sau khi đã tải trọng số, có thể chạy hoàn toàn offline:
# TRYON_OFFLINE=1
